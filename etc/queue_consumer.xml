<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <!--
        ShardConsumer is a lightweight handler (process(string $message): void),
        not a Magento\Framework\MessageQueue\ConsumerInterface impl. Magento
        2.4.x rejects classes registered as `consumerInstance` unless they
        implement that interface — the previous wiring made every
        `consumers_runner` cron tick fail validation, silently stalling all
        other queues. `consumerInstance` removed; the framework's default
        consumer wraps our `handler`.
    -->
    <consumer name="panth_xml_sitemap.sitemap_shard.consumer"
              queue="panth_xml_sitemap.sitemap_shard.q"
              connection="db"
              maxMessages="100"
              handler="Panth\XmlSitemap\Model\Queue\ShardConsumer::process"/>
</config>
