<?xml version="1.0"?>
<!--
/**
 * Panth XML Sitemap - System configuration.
 *
 * Tab `panth` is declared by Panth_Core. Section id matches the Config
 * helper paths (`panth_xml_sitemap/general/*`, `panth_xml_sitemap/generation/*`,
 * `panth_xml_sitemap/hreflang/*`, `panth_xml_sitemap/media/*`,
 * `panth_xml_sitemap/ping/*`, `panth_xml_sitemap/additional/*`).
 *
 * Fields migrated 1:1 from the legacy `panth_seo/sitemap` group in
 * Panth_AdvancedSEO, reorganised into logical groups.
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="panth_xml_sitemap" translate="label" type="text"
                 sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>XML Sitemap</label>
            <tab>panth</tab>
            <resource>Panth_XmlSitemap::config</resource>

            <group id="general" translate="label" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Enables the enhanced XML sitemap generation with automatic sharding, image support, and search engine pinging.</comment>
                </field>
                <field id="homepage_optimization" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Homepage Optimization</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, the homepage entry is emitted with priority 1.0 and daily change frequency.</comment>
                </field>
            </group>

            <group id="generation" translate="label" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Generation</label>
                <field id="index_filename" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sitemap Index Filename</label>
                    <comment>Filename of the generated sitemap index, written into the output directory. Default sitemap.xml. Use sitemap_index.xml to keep the name used before 1.1.0. Any path segment is stripped, so the file always lands in the output directory.</comment>
                </field>
                <field id="shard_size" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>URLs per Shard</label>
                    <validate>validate-digits validate-digits-range digits-range-1000-50000</validate>
                    <comment>Maximum number of URLs per sitemap file before creating a new shard. Google allows up to 50,000 URLs per file. Recommended: 45,000.</comment>
                </field>
                <field id="gzip" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Gzip Output</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Compresses sitemap files with gzip to reduce file size and bandwidth. Search engines support gzipped sitemaps.</comment>
                </field>
                <field id="xsl_enabled" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable XSL Stylesheet</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds an XSL stylesheet reference to the XML sitemap for human-readable rendering in web browsers.</comment>
                </field>
                <field id="exclude_out_of_stock" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Exclude Out-of-Stock Products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Omits products with zero saleable quantity from the XML sitemap to avoid indexing unavailable items.</comment>
                </field>
                <field id="exclude_noindex" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Exclude NOINDEX Pages</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Omits pages marked as noindex from the XML sitemap to keep it consistent with robots directives.</comment>
                </field>
            </group>

            <group id="hreflang" translate="label" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Hreflang</label>
                <field id="include_hreflang" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Hreflang Alternates</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds xhtml:link hreflang alternate entries for multi-language store URLs within the sitemap.</comment>
                </field>
            </group>

            <group id="media" translate="label" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Images &amp; Video</label>
                <field id="include_images" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Image Extension</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Adds image:image entries to product URLs in the sitemap for Google Image Search indexing.</comment>
                </field>
                <field id="product_image_source" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Image Source for Sitemap</label>
                    <source_model>Panth\XmlSitemap\Model\Config\Source\ProductImageSource</source_model>
                    <comment>Which product image role to use in image sitemap entries.</comment>
                    <depends>
                        <field id="include_images">1</field>
                    </depends>
                </field>
                <field id="include_video" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Video Extension</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Include video sitemap entries for products with external video media gallery items.</comment>
                </field>
            </group>

            <group id="ping" translate="label" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Search Engine Ping</label>
                <field id="ping_google" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ping Google on Rebuild</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Notifies Google of the updated sitemap URL after each rebuild for faster crawling of changes.</comment>
                </field>
                <field id="ping_bing" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Ping Bing on Rebuild</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Notifies Bing of the updated sitemap URL after each rebuild for faster crawling of changes.</comment>
                </field>
            </group>

            <group id="additional" translate="label" sortOrder="60"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Additional Links</label>
                <field id="additional_links" translate="label comment" type="textarea" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional Links (one URL per line)</label>
                    <comment>Extra URLs to include in the sitemap that are not auto-discovered (e.g. external landing pages or custom routes).</comment>
                </field>
                <field id="additional_links_changefreq" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional Links Change Frequency</label>
                    <source_model>Panth\XmlSitemap\Model\Config\Source\Changefreq</source_model>
                </field>
                <field id="additional_links_priority" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Additional Links Priority</label>
                    <comment>Value between 0.0 and 1.0. Default: 0.5</comment>
                </field>
            </group>
        </section>
    </system>
</config>
